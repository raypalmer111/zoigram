# A DNS name pointing directly to this Linux VPS, without https:// or a path.
DOMAIN=photos.example.com
COMMUNITY_NAME=Zoigram
# Start with 2 GiB of community photos on a 40 GB VPS; raise after measuring disk use.
STORAGE_LIMIT_MB=2048
BACKUP_KEEP=3
BACKUP_INTERVAL_SECONDS=86400

# One existing profile UUID. Empty disables moderation unless the legacy mapping below is set.
# Set up this profile with a login and password before attempting owner login.
OWNER_PROFILE_ID=
# Migration only: maps an existing Steam profile in the local database; never contacts Steam.
# OWNER_PROFILE_ID takes precedence. Remove this value once the UUID is configured.
OWNER_STEAM_ID=
