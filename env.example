# A DNS name pointing directly to this Linux VPS, without https:// or a path.
DOMAIN=photos.example.com
COMMUNITY_NAME=Zoigram
# Start with 2 GiB of community photos on a 40 GB VPS; raise after measuring disk use.
STORAGE_LIMIT_MB=2048
BACKUP_KEEP=3
BACKUP_INTERVAL_SECONDS=86400

# One verified SteamID64. Empty disables moderation access. Never select the first account automatically.
OWNER_STEAM_ID=
